# Email notifications for the contact form (recommended — this is what makes you receive an email)
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_api_key
# Optional overrides:
# CONTACT_TO_EMAIL=aymansabir32@gmail.com
# RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Supabase (optional — stores every submission in a database as a backup/CRM record)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
